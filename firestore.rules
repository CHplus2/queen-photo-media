rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() { return request.auth != null && request.auth.token.get('staff', false) == true; }
    function owner() { return staff() && request.auth.token.get('owner', false) == true; }
    match /services/{id} {
      allow read: if true;
      allow write: if owner();
    }
    match /orders/{id} {
      allow read: if staff() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      // Online submissions are requests; staff must check price, files and payment.
      allow create: if staff() || (request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == id
        && request.resource.data.channel == 'ONLINE'
        && request.resource.data.paymentStatus == 'BELUM_BAYAR'
        && request.resource.data.orderStatus == 'MENUNGGU_BAYAR'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && !request.resource.data.keys().hasAny(['payments', 'initialPaymentAmount', 'paidAt', 'paymentVerifiedBy', 'recordedBy', 'history', 'materialUsage', 'inventoryWarnings', 'stockExceptionReason', 'cancelledAt', 'cancellationReason'])
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() <= 32
        && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0
        && request.resource.data.totalCost is number && request.resource.data.totalCost >= 0
        && request.resource.data.deliveryFee is number && request.resource.data.deliveryFee >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0 && request.resource.data.totalAmount <= 1000000000000);
      allow update: if owner() || (staff()
        && (request.resource.data.get('inventoryStatus', '') != 'COUNTED' || resource.data.get('inventoryStatus', '') == 'COUNTED')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'paymentStatus', 'payments', 'paidAt', 'paymentVerifiedBy', 'orderStatus', 'history',
        'inventoryStatus', 'inventoryWarnings', 'materialUsage', 'workflowVersion', 'recordedBy',
        'cancelledAt', 'cancellationReason'
      ]));
      allow delete: if owner();
    }
    match /customer_surveys/{id} {
      allow read, update, delete: if owner();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == id
        && request.resource.data.createdAt is string
        && request.resource.data.demandedNewServices is list
        && request.resource.data.demandedNewServices.size() <= 10
        && request.resource.data.primaryNeed is string
        && request.resource.data.primaryNeed.size() <= 200
        && request.resource.data.get('feedbackText', '') is string
        && request.resource.data.get('feedbackText', '').size() <= 2000
        && request.resource.data.satisfactionRating is number
        && request.resource.data.satisfactionRating >= 1
        && request.resource.data.satisfactionRating <= 5;
    }
    match /inventory/{id} {
      allow read: if staff();
      allow create, delete: if owner();
      // Cashier transactions only change balances; material configuration is owner-managed.
      allow update: if owner() || (staff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStock']));
    }
    match /stock_logs/{id} {
      allow read: if staff();
      allow create: if staff() && (request.resource.data.get('inventoryStatus', '') != 'COUNTED' || owner());
      allow update: if staff() && (request.resource.data.get('inventoryStatus', '') != 'COUNTED' || resource.data.get('inventoryStatus', '') == 'COUNTED' || owner());
      allow delete: if owner();
    }
    match /cash_closings/{id} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.by.uid == request.auth.uid
        && request.resource.data.day == id
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.opening is int && request.resource.data.opening >= 0
        && request.resource.data.receipts is int && request.resource.data.receipts >= 0
        && request.resource.data.cashOut is int && request.resource.data.cashOut >= 0
        && request.resource.data.counted is int && request.resource.data.counted >= 0
        && request.resource.data.expected == request.resource.data.opening + request.resource.data.receipts - request.resource.data.cashOut
        && request.resource.data.difference == request.resource.data.counted - request.resource.data.expected
        && request.resource.data.receiptIds is list
        && request.resource.data.note is string
        && (request.resource.data.cashOut == 0 || request.resource.data.note.size() > 0);
      allow update, delete: if owner();
    }
    match /admins/{id} {
      allow read, write: if owner();
    }
    match /test/{id} {
      allow read, write: if owner();
    }
    match /{name}/{id} {
      allow read: if staff() && name == 'studio_settings';
      allow write: if owner() && name == 'studio_settings';
    }
  }
}
