rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Services / Menu Items Collection
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Orders collection for Queen Photo
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Studio Settings & Roll Paper Configurations
    match /studio_settings/{settingId} {
      allow read, write: if true;
    }

    // Inventory & Stock Tracking
    match /inventory/{itemId} {
      allow read, write: if true;
    }

    // Stock Audit Logs
    match /stock_logs/{logId} {
      allow read, write: if true;
    }

    // Admin accounts collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
